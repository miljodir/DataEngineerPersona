# =============================================================================
# SQL Server to PostgreSQL Migration — Environment Variables
# =============================================================================
# Copy this file to .env and adjust:
#   cp .env.example .env
#
# This file supports TWO modes:
#
#   1) DEMO mode (default values below) — local Docker WideWorldImporters lab.
#      Just `cp .env.example .env` and run `wsl zsh -c "scripts/setup-local-env.sh"`.
#
#   2) BRING-YOUR-OWN-ENDPOINT mode — point at any customer SQL Server and
#      any PostgreSQL (Azure Flexible Server, AWS RDS, on-prem, etc.).
#      Edit the SQLSERVER_* and PG* variables below, then run
#      `wsl zsh -c "scripts/migrate-endpoint.sh"`.
#
# For Azure SQL with Entra ID (your own az login), set these in .env:
#   SQLSERVER_AUTH_MODE='aad'
#   PGLOADER_RUNTIME='local'
#   PGLOADER_JAR="${HOME}/.local/share/pgloader4/pgloader.jar"
# and run `az login` inside WSL. Requires Java 21+ and the pgloader v4 JAR.
#
# Values are single-quoted so bash `source` and docker-compose both parse
# them correctly (semicolons and spaces would otherwise break bash).
# =============================================================================

# ---------------------------------------------------------------------------
# SQL Server (source)
# ---------------------------------------------------------------------------
export SA_PASSWORD='Weakerpassword'                     # Used by docker-compose for the local demo

export SQLSERVER_HOST='127.0.0.1'                        # e.g. 'mycorp-sql.database.windows.net'
export SQLSERVER_PORT='1433'
export SQLSERVER_DB='WideWorldImporters'                 # Your customer DB name
# 'aad' uses your WSL `az login` (ActiveDirectoryDefault) and requires
# PGLOADER_RUNTIME='local'. SQLSERVER_USER/PASSWORD are ignored in aad mode.
export SQLSERVER_AUTH_MODE='sql'                        # 'sql' for demo, 'aad' for Entra ID
export SQLSERVER_USER='sa'                               # SQL authentication only
export SQLSERVER_PASSWORD='Weakerpassword'              # SQL authentication only; demo value

# ---------------------------------------------------------------------------
# PostgreSQL (target)
# ---------------------------------------------------------------------------
export PGPASSWORD='Weakerpassword'                     # Used by docker-compose for the local demo

export PGHOST='127.0.0.1'                               # e.g. 'mycorp-pg.postgres.database.azure.com'
export PGPORT='5432'
export PGUSER='wwi_user'                                # e.g. 'migrate_user'
export PGDATABASE='wide_world_importers'                      # Your target DB name
# For a Nais personal-access proxy, use the TLS server name as PGHOST, its
# loopback listen address as PGHOSTADDR, PGSSLMODE=verify-full, and the proxy's
# CA path as PGSSLROOTCERT. Local pgloader also needs libnss-wrapper when
# PGHOSTADDR is set. Keep proxy credentials and paths in your local .env.
export PGHOSTADDR=''
export PGSSLMODE='disable'                              # Set to verify-full for Nais
export PGSSLROOTCERT=''

# 'local' runs pgloader v4 directly (required for aad): set PGLOADER_JAR to the
# v4 JAR, or leave it empty to use a pgloader4 executable on PATH.
# 'podman' runs the container image (SQL auth only).
export PGLOADER_RUNTIME='podman'                        # 'local' for aad
export PGLOADER_JAR=''
export PGLOADER_IMAGE='ghcr.io/dimitri/pgloader-v4:latest'

# ---------------------------------------------------------------------------
# DAB (Data API Builder) connection strings — read by dab/dab-config-*.json
# ---------------------------------------------------------------------------
export SQLSERVER_CONN='Server=127.0.0.1,1433;Database=WideWorldImporters;User Id=sa;Password=Weakerpassword;TrustServerCertificate=True;'
export POSTGRES_CONN='Host=127.0.0.1;Port=5432;Database=wide_world_importers;Username=wwi_user;Password=Weakerpassword;'

# ---------------------------------------------------------------------------
# Optional: Microsoft Fabric SQL DB (Phases 4-5)
# ---------------------------------------------------------------------------
# FABRIC_CONN='Server=your-server.database.fabric.microsoft.com;Database=WideWorldImporters;Authentication=Active Directory Default;'
