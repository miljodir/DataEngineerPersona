# Dependencies
node_modules/
.env
*.env.local

# DAB
dab/.env

# Local database data (cached backups, Docker volumes)
data/

# Build outputs
bin/
obj/
dist/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Test results (keep templates, ignore generated)
tests/performance/results/*.json
!tests/performance/results/README.md

# Security scan results (sensitive)
security/sec-check-results/*.json

# SSMS execution plans (large binary)
benchmarks/ssms-plans/*.sqlplan

# pgLoader state
*.pgloader

# Internal authoring notes (kept local, never published)
DEMO-SCRIPT.md
SALES-PITCH-DBA.md
SALES-PITCH-*.md
*.internal.md

# PowerShell variants kept local (bash is the canonical public path)
scripts/*.ps1

# Temp / scratch
.tmp/
*.log

